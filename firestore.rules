rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      // Anyone can read room data (password is NOT stored here)
      allow read: if true;

      // Plaintext password must never be written to the room document
      allow create: if !('password' in request.resource.data);
      allow update: if !('password' in request.resource.data);
      allow delete: if true;

      // Private subcollection — accessible only by the server via Admin SDK
      match /private/{document} {
        allow read, write: if false;
      }

      // Chat messages subcollection — anyone in the session can read/create, no edits/deletes
      match /messages/{messageId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    match /analytics/{document} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
